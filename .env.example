# Server environment. Never put SUPABASE_SECRET_KEY in public/ or a build variable.
APP_MODE=production
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_SECRET_KEY=sb_secret_REPLACE
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_SALT=REPLACE_WITH_RANDOM_32_BYTES
# Production fails closed unless a bot check is configured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# For local integration ONLY: never allow this in VERCEL_ENV=production.
ALLOW_LOCAL_NO_BOT=false
